<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build.

  {{PLACEHOLDERS}} are filled in by scripts/pack-msix.mjs. Identity/Name and
  Identity/Publisher are NOT free choices: Partner Center assigns them when
  the app name is reserved, and a package whose identity doesn't match the
  reservation is rejected at submission. They're read from msix.config.json.

  The app runs full trust (runFullTrust): Shota registers global hotkeys,
  reads the screen, and calls DWM directly, none of which a sandboxed
  container app can do.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  IgnorableNamespaces="uap uap2 uap3 rescap desktop">

  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{{DISPLAY_NAME}}</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- 17763 is Windows 10 1809, the oldest release with the MSIX and
         WebView2 support Shota needs. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <!-- Every language the app's UI ships in. The Store uses these to decide
       which markets see the listing as localised, so a missing entry is a
       market that never learns the app speaks its language. -->
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="fr" />
    <Resource Language="de" />
    <Resource Language="es" />
    <Resource Language="ja" />
    <Resource Language="ko" />
    <Resource Language="zh-Hans" />
    <Resource Language="zh-Hant" />
    <Resource Language="pt-BR" />
    <Resource Language="it" />
    <Resource Language="nl" />
    <Resource Language="pl" />
    <Resource Language="ru" />
    <Resource Language="uk" />
    <Resource Language="tr" />
  </Resources>

  <Applications>
    <Application Id="Shota" Executable="shota.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{{DISPLAY_NAME}}"
        Description="{{DESCRIPTION}}"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile ShortName="{{DISPLAY_NAME}}">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
      <!-- Launch at startup. A packaged app's writes to the Run key are
           virtualized and never read at sign-in, so the Store build uses
           this instead; startup.rs toggles it at runtime. Declared off: it
           stays off until someone turns it on in settings. TaskId must
           match STORE_TASK_ID in startup.rs. -->
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="shota.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="ShotaStartup" Enabled="false" DisplayName="{{DISPLAY_NAME}}" />
        </desktop:Extension>
        <!-- "Edit with Shota" in Explorer's right-click menu on images, and
             Shota in their "Open with" list. SupportedFileTypes alone never
             makes Shota the default app for these. The GitHub build writes
             the same verb to the registry instead (explorer.rs); keep the
             two lists of extensions alike. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="images">
            <uap:DisplayName>{{DISPLAY_NAME}}</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <uap3:Verb Id="edit" Parameters="&quot;%1&quot;">Edit with Shota</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
