{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main", "overlay", "editor"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "opener:default",
    "fs:default",
    "fs:allow-write-file",
    "dialog:default",
    "clipboard-manager:allow-write-image"
  ]
}
