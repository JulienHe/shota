{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shota",
  "version": "0.3.0",
  "identifier": "com.julie.shota",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Shota",
        "width": 360,
        "height": 480,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1RjM3RDhERUQzQzJDNTEKUldSUkxEenRqWDN6TlpGRCtOTE54SGp2S3Y1UDN5SkRmTENXT0QrTXVlVnRKTGR3clBOZHMyNTIK",
      "endpoints": [
        "https://github.com/JulienHe/shota/releases/latest/download/latest.json"
      ]
    }
  }
}
